[user]
	email = voropaev.roma@gmail.com
	name = Roman Voropaev

[push]
  # push should only push current branch, not all branches
  default = current
[branch]
  # git pull should always rebase
  autosetuprebase = always

[color]
  ui = auto

[rerere]
	enabled = true
[core]
	autocrlf = input
	excludesfile = /Users/roma/.gitignore_global
[diff]
	tool = vimdiff
[merge]
    tool = opendiff
    conflictstyle = diff3
[mergetool]
    prompt = false

# http://bit.ly/g9c9Y2    (allows: git clone gh:rails/rails)
[url "git@github.com:"]
  pushInsteadOf = "gh:"
  insteadOf = "gh:"

[url "git@github.com:roma-guru/"]
  pushInsteadOf = "my:"
  insteadOf = "my:"

[url "git@github.com:PacktPublishing"]
  insteadOf = "packt:"

[pull]
  rebase = true
